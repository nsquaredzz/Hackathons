# Copy to .env and fill in. With no key the app runs in rule-based mock mode.

# Google AI Studio key (https://aistudio.google.com/apikey). This is what the judges should see.
GEMINI_API_KEY=
# Use the exact model id shown in AI Studio for Gemini 3.8 Flash.
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy (503/429).
GEMINI_BACKUP_MODELS=gemini-3.7-flash,gemini-3.5-flash

# Optional development fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Force a backend: gemini | anthropic | claude-cli | mock
# claude-cli calls the local Claude Code CLI with your own login (local dev only; run `claude` then /login first).
LLM_PROVIDER=
CLAUDE_CLI_MODEL=sonnet

# Earth Engine project for pipeline/gee_precompute.py
EE_PROJECT=
